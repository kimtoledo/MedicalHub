{
  "name": "dentra-ph",
  "version": "0.1.0",
  "private": true,
  "description": "Dentra.ph — Multi-tenant dental SaaS platform for the Philippines",
  "scripts": {
    "dev": "cd apps/web && npx next dev -p 5001",
    "dev:safe": "./scripts/start-web-dev.sh",
    "api:dev": "npm run dev --workspace @dentra/api",
    "api:start": "npm run start --workspace @dentra/api",
    "build": "npm run build --workspace @dentra/web && npm run build --workspace @dentra/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:generate": "cd packages/db && npx drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "cd packages/db && DRIZZLE_MIGRATION=true npx drizzle-kit migrate --config=drizzle.config.ts && cd ../.. && npm run db:check",
    "db:check": "tsx scripts/check-database-readiness.ts",
    "db:reconcile-order": "tsx scripts/reconcile-migration-order.ts && npm run db:check",
    "db:studio": "cd packages/db && npx drizzle-kit studio --config=drizzle.config.ts",
    "db:push": "cd packages/db && npx drizzle-kit push --config=drizzle.config.ts",
    "db:seed": "tsx scripts/seed-demo.ts"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@better-auth/utils": "0.4.2",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "autoprefixer": "^10.5.4",
    "dotenv": "16.4.5",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^0.400.0",
    "next": "^14.2.29",
    "postcss": "^8.5.26",
    "postgres": "^3.4.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.2"
  }
}
