{
  "name": "toothhub-ph",
  "version": "0.1.0",
  "private": true,
  "description": "ToothHub PH — Multi-tenant dental SaaS platform for the Philippines",
  "scripts": {
    "dev": "cd apps/web && npx next dev -p 5000",
    "build": "cd apps/web && npx next build",
    "db:generate": "cd packages/db && npx drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "cd packages/db && DRIZZLE_MIGRATION=true npx drizzle-kit migrate --config=drizzle.config.ts",
    "db:studio": "cd packages/db && npx drizzle-kit studio --config=drizzle.config.ts",
    "db:push": "cd packages/db && npx drizzle-kit push --config=drizzle.config.ts"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "autoprefixer": "^10.5.4",
    "drizzle-orm": "^0.32.0",
    "lucide-react": "^0.400.0",
    "next": "^14.2.29",
    "postcss": "^8.5.26",
    "postgres": "^3.4.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "drizzle-kit": "^0.23.0"
  }
}
