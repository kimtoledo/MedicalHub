# =============================================================================
# Dentra.ph — Environment Variables
# Copy this file to .env for local development.
# NEVER commit .env or any file containing real secrets.
# On Replit: use Replit Secrets instead of .env files.
# =============================================================================

# ---------------------------------------------------------------------------
# Database (required)
# ---------------------------------------------------------------------------
# Replit PostgreSQL connection string.
# Get the value from Replit Secrets > DATABASE_URL.
# For local VS Code / Codex dev: copy the value here.  
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ---------------------------------------------------------------------------
# Application URLs
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:5001
NEXT_PUBLIC_API_URL=http://localhost:3001
# Optional server-only URL used by the Next.js proxy/session guard.
# Defaults to NEXT_PUBLIC_API_URL.
# API_INTERNAL_URL=http://localhost:3001

# Fastify API runtime
API_HOST=0.0.0.0
API_PORT=3001
API_LOG_LEVEL=info
# Comma-separated allowlist. Defaults to NEXT_PUBLIC_APP_URL when omitted.
CORS_ORIGINS=http://localhost:5001

# ---------------------------------------------------------------------------
# Auth (Better Auth)
# ---------------------------------------------------------------------------
# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=change-me-generate-a-random-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3001
# SESSION_SECRET is accepted as a legacy local-development fallback.

# Development login credentials used only by npm run db:seed:accounts.
# Keep values in your git-ignored .env or Replit Secrets. Minimum: 10 characters.
# Never reuse production passwords or commit real values.
DEV_SUPER_ADMIN_PASSWORD=
# Shared development password for seeded clinic staff + dentist logins.
DEV_CLINIC_PASSWORD=

# Full synthetic demo-data seed credentials (npm run db:seed).
SUPER_ADMIN_PASSWORD=
CLINIC_DEMO_PASSWORD=

# ---------------------------------------------------------------------------
# reCAPTCHA (public appointment booking form)
# ---------------------------------------------------------------------------
# Register a v2 "checkbox" site at https://www.google.com/recaptcha/admin
# NEXT_PUBLIC_RECAPTCHA_SITE_KEY is embedded in the browser bundle; RECAPTCHA_SECRET_KEY
# stays server-side. If RECAPTCHA_SECRET_KEY is left blank, the API skips verification
# (useful for local dev before you've registered a site).
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# ---------------------------------------------------------------------------
# Storage — AWS S3 (clinical files, branding, verification docs, consult photos)
# ---------------------------------------------------------------------------
# Create a private bucket + an IAM user limited to that bucket (see docs).
# STORAGE_BUCKET       — bucket name, e.g. dentra-ph-files
# STORAGE_REGION       — bucket region, e.g. ap-southeast-1 (falls back to AWS_REGION)
# STORAGE_ACCESS_KEY   — IAM access key id  (omit both keys to use the default
# STORAGE_SECRET_KEY   — IAM secret key       AWS credential chain / instance role)
# STORAGE_ENDPOINT     — only for S3-compatible stores (MinIO / R2 / LocalStack)
STORAGE_BUCKET=
STORAGE_REGION=ap-southeast-1
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
# STORAGE_ENDPOINT=

# ---------------------------------------------------------------------------
# Email — platform SMTP transport (SMTP2GO)
# ---------------------------------------------------------------------------
# Fallback sender for notification emails that have no clinic-connected
# provider — e.g. dentist-verification emails. Clinic-connected providers
# (Settings > Notifications) still take precedence. Leave SMTP_HOST blank to
# disable the fallback; those rows then fail with a clear reason instead of
# being sent.
#   SMTP_HOST       — mail.smtp2go.com
#   SMTP_PORT       — 2525 (also 587 / 8025 / 80 / 25; 465 / 8465 / 443 for SSL)
#   SMTP_USER       — SMTP2GO username
#   SMTP_PASSWORD   — SMTP2GO password
#   SMTP_SECURE     — "true" only for implicit SSL ports (465). STARTTLS is
#                     automatic on 587 / 2525, so leave this unset there.
#   EMAIL_FROM      — verified sender address, e.g. no-reply@dentra.ph
#   EMAIL_FROM_NAME — optional display name, e.g. Dentra.ph
SMTP_HOST=
SMTP_PORT=2525
SMTP_USER=
SMTP_PASSWORD=
# SMTP_SECURE=false
EMAIL_FROM=
EMAIL_FROM_NAME=Dentra.ph
